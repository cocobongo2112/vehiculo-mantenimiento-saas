<%
  const badge = (estado) => {
    if (estado === "RECIBIDO") return "bg-cyan-500/15 border-cyan-400/20 text-cyan-200";
    if (estado === "EN_PROCESO") return "bg-indigo-500/15 border-indigo-400/20 text-indigo-200";
    if (estado === "LISTO") return "bg-emerald-500/15 border-emerald-400/20 text-emerald-200";
    if (estado === "ENTREGADO") return "bg-slate-500/15 border-slate-400/20 text-slate-200";
    return "bg-white/10 border-white/10 text-slate-200";
  };

  const badgePrioridad = (prioridad) => {
    if (prioridad === "BAJA") return "bg-sky-500/15 border-sky-400/20 text-sky-200";
    if (prioridad === "MEDIA") return "bg-amber-500/15 border-amber-400/20 text-amber-200";
    if (prioridad === "ALTA") return "bg-orange-500/15 border-orange-400/20 text-orange-200";
    if (prioridad === "URGENTE") return "bg-rose-500/15 border-rose-400/20 text-rose-200";
    return "bg-white/10 border-white/10 text-slate-200";
  };

  const formatFechaHora = (valor) => {
  if (!valor) return "—";
  const fecha = new Date(valor);
  if (Number.isNaN(fecha.getTime())) return valor;

  return fecha.toLocaleString("es-MX", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit"
  });
};

  let serviciosOrden = [];
  try {
    serviciosOrden = orden && orden.servicios ? JSON.parse(orden.servicios) : [];
    if (!Array.isArray(serviciosOrden)) serviciosOrden = [];
  } catch (e) {
    serviciosOrden = [];
  }
%>

<section class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/5 to-white/0 p-8 md:p-12">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <p class="text-cyan-300 text-sm tracking-wide">TALLER · SMART GARAGE</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-extrabold">
        Orden <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-500"><%= orden.folio %></span>
      </h1>
      <p class="mt-2 text-slate-300">
        Cliente, vehículo, estado actual y bitácora completa del servicio.
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <a href="/taller/ordenes"
         class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">
        ← Volver a órdenes
      </a>

      <form method="POST" action="/taller/ordenes/<%= orden.id %>/delete"
            onsubmit="return confirm('¿Eliminar esta orden? Esta acción no se puede deshacer.');">
        <button class="px-4 py-2 rounded-xl bg-rose-500/15 hover:bg-rose-500/25 border border-rose-500/30 text-sm text-rose-200">
          Eliminar
        </button>
      </form>
    </div>
  </div>

  <div class="mt-8 grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <!-- Card: Información -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div>
            <h3 class="text-lg font-semibold">Información de la orden</h3>
            <p class="text-sm text-slate-300 mt-1">Datos principales del servicio.</p>
          </div>

          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-2 rounded-full text-xs border <%= badge(orden.estado) %>">
              <%= orden.estado %>
            </span>

            <span class="px-3 py-2 rounded-full text-xs border <%= badgePrioridad(orden.prioridad || 'MEDIA') %>">
              Prioridad: <%= orden.prioridad || "MEDIA" %>
            </span>
          </div>
        </div>

        <div class="mt-6 grid sm:grid-cols-2 gap-4 text-sm">
          <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-4">
            <p class="text-xs text-slate-400">Cliente</p>
            <p class="mt-1 font-semibold text-slate-100"><%= orden.cliente %></p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-4">
            <p class="text-xs text-slate-400">Vehículo</p>
            <p class="mt-1 font-semibold text-slate-100">
              <%= orden.marca %> <%= orden.modelo %> (<%= orden.placa %>)
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-4">
            <p class="text-xs text-slate-400">Kilometraje de entrada</p>
            <p class="mt-1 font-semibold text-slate-100"><%= orden.kilometraje || "—" %></p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-4">
            <p class="text-xs text-slate-400">Entrega estimada</p>
            <p class="mt-1 font-semibold text-slate-100"><%= formatFechaHora(orden.fecha_entrega) %></p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-4 sm:col-span-2">
            <p class="text-xs text-slate-400">Servicios solicitados</p>

            <% if (serviciosOrden.length) { %>
              <div class="mt-3 flex flex-wrap gap-2">
                <% serviciosOrden.forEach(s => { %>
                  <span class="px-3 py-2 rounded-xl border border-cyan-400/20 bg-cyan-500/10 text-cyan-200 text-xs">
                    <%= s %>
                  </span>
                <% }) %>
              </div>
            <% } else { %>
              <p class="mt-1 text-slate-400">No se registraron servicios específicos.</p>
            <% } %>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-4 sm:col-span-2">
            <p class="text-xs text-slate-400">Descripción</p>
            <p class="mt-1 text-slate-200 whitespace-pre-line"><%= orden.descripcion || "—" %></p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-4">
            <p class="text-xs text-slate-400">ID orden</p>
            <p class="mt-1 font-semibold text-slate-100">#<%= orden.id %></p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-4">
            <p class="text-xs text-slate-400">Folio</p>
            <p class="mt-1 font-semibold text-slate-100"><%= orden.folio %></p>
          </div>
        </div>
      </div>

      <!-- Card: Timeline -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold">Bitácora / Eventos</h3>
          <span class="text-xs text-slate-400">Historial del servicio</span>
        </div>

        <div class="mt-6 space-y-4">
          <% if (eventos && eventos.length) { %>
            <% eventos.forEach((e, idx) => { %>
              <div class="flex gap-4">
                <div class="flex flex-col items-center">
                  <div class="h-3 w-3 rounded-full bg-cyan-400/80"></div>
                  <% if (idx !== eventos.length - 1) { %>
                    <div class="w-px flex-1 bg-white/10 mt-2"></div>
                  <% } %>
                </div>

                <div class="flex-1 rounded-2xl border border-white/10 bg-slate-900/50 p-4">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <p class="text-sm font-semibold">
                        <%= e.evento %>
                        <% if (e.nota) { %>
                          <span class="text-slate-400 font-normal">· <%= e.nota %></span>
                        <% } %>
                      </p>
                      <p class="text-xs text-slate-400 mt-1"><%= e.created_at %></p>
                    </div>
                    <span class="text-xs text-slate-400">#<%= idx + 1 %></span>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-4 text-slate-400 text-sm">
              Sin eventos aún.
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Col 3: Acciones -->
    <div class="space-y-6">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <h3 class="text-lg font-semibold">Acciones</h3>
        <p class="text-sm text-slate-300 mt-1">Actualiza el estado del servicio.</p>

        <form method="POST" action="/taller/ordenes/<%= orden.id %>/estado" class="mt-6 space-y-3">
          <label class="text-sm text-slate-300">Cambiar estado</label>

          <select name="estado"
                  class="w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3 outline-none focus:border-cyan-400/40">
            <option value="RECIBIDO" <%= orden.estado==='RECIBIDO'?'selected':'' %>>RECIBIDO</option>
            <option value="EN_PROCESO" <%= orden.estado==='EN_PROCESO'?'selected':'' %>>EN_PROCESO</option>
            <option value="LISTO" <%= orden.estado==='LISTO'?'selected':'' %>>LISTO</option>
            <option value="ENTREGADO" <%= orden.estado==='ENTREGADO'?'selected':'' %>>ENTREGADO</option>
          </select>

          <button
            class="w-full px-5 py-3 rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold">
            Guardar estado
          </button>
        </form>

        <div class="mt-5 rounded-2xl border border-white/10 bg-slate-900/50 p-4 text-xs text-slate-300">
          💬 Si cambias a <b>LISTO</b>, el sistema puede notificar por Telegram (n8n + IA).
        </div>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <h3 class="text-lg font-semibold">Atención al cliente</h3>
        <p class="text-sm text-slate-300 mt-1">El cliente puede consultar por chatbot.</p>

        <div class="mt-4 rounded-2xl border border-white/10 bg-slate-900/50 p-4 text-sm text-slate-200">
          <p class="text-xs text-slate-400">Folio a compartir</p>
          <div class="mt-2 flex items-center justify-between">
            <span class="font-semibold"><%= orden.folio %></span>
            <button type="button" id="copyFolio"
              class="px-3 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-xs">
              Copiar
            </button>
          </div>
        </div>

        <a href="/chat"
           class="mt-4 inline-flex w-full justify-center px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">
          Abrir Chatbot →
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("copyFolio");
  btn?.addEventListener("click", async () => {
    const folio = "<%= orden.folio %>";
    try {
      await navigator.clipboard.writeText(folio);
      btn.textContent = "Copiado ✅";
      setTimeout(() => btn.textContent = "Copiar", 1200);
    } catch(e) {
      alert("No se pudo copiar. Folio: " + folio);
    }
  });
</script>