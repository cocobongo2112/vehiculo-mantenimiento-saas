<section class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/5 to-white/0 p-8 md:p-12">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <p class="text-cyan-300 text-sm tracking-wide">TALLER · SMART GARAGE</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-extrabold">Dashboard del Taller</h1>
      <p class="mt-2 text-slate-300">Seguimiento visual de la carga operativa, entregas y actividad reciente.</p>
    </div>

    <div class="flex flex-wrap gap-2">
      <a href="/taller/clientes" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">Clientes</a>
      <a href="/taller/vehiculos" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">Vehículos</a>
      <a href="/taller/ordenes" class="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold text-sm">Órdenes</a>
    </div>
  </div>

  <div class="mt-8 grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><p class="text-sm text-slate-400">Órdenes totales</p><p class="mt-2 text-3xl font-extrabold"><%= total %></p></div>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><p class="text-sm text-slate-400">Entregas próximas</p><p class="mt-2 text-3xl font-extrabold"><%= proximas.length %></p></div>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><p class="text-sm text-slate-400">Órdenes vencidas</p><p class="mt-2 text-3xl font-extrabold"><%= vencidas %></p></div>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><p class="text-sm text-slate-400">Recientes</p><p class="mt-2 text-3xl font-extrabold"><%= recientes.length %></p></div>
  </div>

  <div class="mt-8 grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-1 rounded-2xl border border-white/10 bg-white/5 p-6">
      <div class="flex items-center justify-between"><h3 class="text-lg font-semibold">Estado de órdenes</h3><span class="text-xs text-slate-400">Resumen</span></div>
      <div class="mt-4 space-y-3">
        <% if (porEstado && porEstado.length) { %>
          <% porEstado.forEach(s => { %>
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 flex items-center justify-between gap-3">
              <div>
                <div class="text-xs text-slate-400">Estado</div>
                <div class="font-semibold"><%= s.estado %></div>
              </div>
              <div class="text-2xl font-extrabold"><%= s.cantidad %></div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 text-slate-400">Sin datos aún.</div>
        <% } %>
      </div>
    </div>

    <div class="lg:col-span-2 rounded-2xl border border-white/10 bg-white/5 p-6 overflow-x-auto">
      <div class="flex items-center justify-between"><h3 class="text-lg font-semibold">Órdenes recientes</h3><span class="text-xs text-slate-400">Últimas 6</span></div>
      <table class="min-w-full text-sm mt-4">
        <thead class="text-slate-400">
          <tr class="border-b border-white/10">
            <th class="text-left py-3 pr-4">Folio</th>
            <th class="text-left py-3 pr-4">Cliente</th>
            <th class="text-left py-3 pr-4">Vehículo</th>
            <th class="text-left py-3 pr-4">Prioridad</th>
            <th class="text-left py-3">Estado</th>
          </tr>
        </thead>
        <tbody class="text-slate-200">
          <% if (recientes && recientes.length) { %>
            <% recientes.forEach(o => { %>
              <tr class="border-b border-white/5 hover:bg-white/5">
                <td class="py-3 pr-4 font-semibold"><%= o.folio %></td>
                <td class="py-3 pr-4"><%= o.cliente %></td>
                <td class="py-3 pr-4 text-slate-300"><%= o.marca %> <%= o.modelo %> (<%= o.placa %>)</td>
                <td class="py-3 pr-4"><span class="px-2 py-1 rounded-full text-xs bg-white/10 border border-white/10"><%= o.prioridad %></span></td>
                <td class="py-3"><span class="px-2 py-1 rounded-full text-xs bg-cyan-500/15 border border-cyan-500/30 text-cyan-200"><%= o.estado %></span></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="py-8 text-slate-400">Sin órdenes recientes.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-8 rounded-2xl border border-white/10 bg-white/5 p-6 overflow-x-auto">
    <div class="flex items-center justify-between"><h3 class="text-lg font-semibold">Próximas entregas</h3><span class="text-xs text-slate-400">Top 5</span></div>
    <table class="min-w-full text-sm mt-4">
      <thead class="text-slate-400">
        <tr class="border-b border-white/10"><th class="text-left py-3 pr-4">Folio</th><th class="text-left py-3 pr-4">Estado</th><th class="text-left py-3">Entrega</th></tr>
      </thead>
      <tbody class="text-slate-200">
        <% if (proximas && proximas.length) { %>
          <% proximas.forEach(o => { %>
            <tr class="border-b border-white/5 hover:bg-white/5">
              <td class="py-3 pr-4 font-semibold"><%= o.folio %></td>
              <td class="py-3 pr-4"><span class="px-2 py-1 rounded-full text-xs border border-white/10 bg-white/10"><%= o.estado %></span></td>
              <td class="py-3 text-slate-300"><%= o.fecha_entrega || '-' %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="3" class="py-8 text-slate-400">Sin entregas programadas.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
