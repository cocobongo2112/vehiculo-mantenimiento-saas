<section class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/5 to-white/0 p-8 md:p-12">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <p class="text-cyan-300 text-sm tracking-wide">TALLER · SMART GARAGE</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-extrabold">Dashboard del Taller</h1>
      <p class="mt-2 text-slate-300">Seguimiento del trabajo y próximas entregas.</p>
    </div>

    <div class="flex gap-2">
      <a href="/taller/clientes" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">Clientes</a>
      <a href="/taller/vehiculos" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">Vehículos</a>
      <a href="/taller/ordenes" class="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold rounded-xl text-sm">Órdenes</a>
    </div>
  </div>

  <!-- KPI Total -->
  <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5 hover:bg-white/10 transition lg:col-span-1">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm text-slate-400">Órdenes totales</p>
          <p class="mt-2 text-3xl font-extrabold"><%= total %></p>
          <p class="mt-1 text-xs text-slate-500">Acumuladas</p>
        </div>
        <div class="text-3xl">🧾</div>
      </div>
    </div>

    <!-- Por estado -->
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5 hover:bg-white/10 transition lg:col-span-3">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold">Estado de órdenes</h3>
        <span class="text-xs text-slate-400">Resumen</span>
      </div>

      <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <% const color = (estado) => {
          if (estado === "RECIBIDO") return "bg-cyan-500/15 border-cyan-400/20 text-cyan-200";
          if (estado === "EN_PROCESO") return "bg-indigo-500/15 border-indigo-400/20 text-indigo-200";
          if (estado === "LISTO") return "bg-emerald-500/15 border-emerald-400/20 text-emerald-200";
          if (estado === "ENTREGADO") return "bg-slate-500/15 border-slate-400/20 text-slate-200";
          return "bg-white/10 border-white/10 text-slate-200";
        }; %>

        <% if (porEstado && porEstado.length) { %>
          <% porEstado.forEach(s => { %>
            <div class="rounded-2xl border p-4 <%= color(s.estado) %>">
              <div class="text-xs opacity-80">Estado</div>
              <div class="mt-1 font-semibold"><%= s.estado %></div>
              <div class="mt-2 text-2xl font-extrabold"><%= s.cantidad %></div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="sm:col-span-2 lg:col-span-4 p-4 rounded-2xl bg-slate-900/60 border border-white/10 text-slate-400">
            Sin datos aún.
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Próximas entregas -->
  <div class="mt-8 rounded-2xl border border-white/10 bg-white/5 p-6">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold">Próximas entregas</h3>
      <span class="text-xs text-slate-400">Top 5</span>
    </div>

    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-slate-400">
          <tr class="border-b border-white/10">
            <th class="text-left py-3 pr-4">Folio</th>
            <th class="text-left py-3 pr-4">Estado</th>
            <th class="text-left py-3">Entrega</th>
          </tr>
        </thead>
        <tbody class="text-slate-200">
          <% if (proximas && proximas.length) { %>
            <% proximas.forEach(o => { %>
              <tr class="border-b border-white/5 hover:bg-white/5">
                <td class="py-3 pr-4 font-semibold"><%= o.folio %></td>
                <td class="py-3 pr-4">
                  <span class="px-2 py-1 rounded-full text-xs border border-white/10 bg-white/10"><%= o.estado %></span>
                </td>
                <td class="py-3 text-slate-300"><%= o.fecha_entrega || "-" %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="3" class="py-6 text-slate-400">Sin entregas programadas.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="mt-5 flex flex-wrap gap-2">
      <a href="/taller/ordenes" class="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold text-sm">
        Ir a Órdenes
      </a>
      <a href="/taller/clientes" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">
        Ver Clientes
      </a>
      <a href="/taller/vehiculos" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">
        Ver Vehículos
      </a>
    </div>
  </div>
</section>
