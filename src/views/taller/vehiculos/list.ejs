<section class="rounded-3xl border border-white/10 bg-white/5 p-8">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-extrabold">Vehículos</h1>
    <a href="/taller/vehiculos/new" class="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold">
      + Nuevo Vehículo
    </a>
  </div>

  <div class="mt-6 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="text-slate-400">
        <tr class="border-b border-white/10">
          <th class="text-left py-3 pr-4">Cliente</th>
          <th class="text-left py-3 pr-4">Vehículo</th>
          <th class="text-left py-3 pr-4">Placa</th>
          <th class="text-left py-3 pr-4">Año</th>
          <th class="text-left py-3 pr-4">Acciones</th>
        </tr>
      </thead>
      <tbody class="text-slate-200">
        <% if (vehiculos && vehiculos.length) { %>
          <% vehiculos.forEach(v => { %>
            <tr class="border-b border-white/5 hover:bg-white/5">
              <td class="py-3 pr-4"><%= v.cliente_nombre %></td>
              <td class="py-3 pr-4"><%= v.marca %> <%= v.modelo %></td>
              <td class="py-3 pr-4"><%= v.placa %></td>
              <td class="py-3 pr-4"><%= v.anio || "-" %></td>
              <td class="py-3 pr-4 flex gap-2">
                <a class="px-3 py-2 rounded-xl bg-white/10 border border-white/10 text-xs"
                   href="/taller/vehiculos/<%= v.id %>/edit">Editar</a>

                <form method="POST" action="/taller/vehiculos/<%= v.id %>/delete"
                      onsubmit="return confirm('¿Desactivar vehículo? No se borrará, solo quedará oculto.')">
                  <button class="px-3 py-2 rounded-xl bg-red-500/20 border border-red-500/30 text-xs">Desactivar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" class="py-8 text-slate-400">No hay vehículos registrados.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>