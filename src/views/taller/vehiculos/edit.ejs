<section class="rounded-3xl border border-white/10 bg-white/5 p-8">
  <h1 class="text-3xl font-extrabold">Editar Vehículo</h1>

  <form class="mt-6 grid md:grid-cols-2 gap-4" method="POST">
    <div class="md:col-span-2">
      <label class="text-sm text-slate-300">Cliente</label>
      <select name="cliente_id" class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3" required>
        <% clientes.forEach(c => { %>
          <option value="<%= c.id %>" <%= vehiculo.cliente_id==c.id ? "selected":"" %>><%= c.nombre %></option>
        <% }) %>
      </select>
    </div>

    <div>
      <label class="text-sm text-slate-300">Marca</label>
      <input name="marca" value="<%= vehiculo.marca %>" class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3" required>
    </div>

    <div>
      <label class="text-sm text-slate-300">Modelo</label>
      <input name="modelo" value="<%= vehiculo.modelo %>" class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3" required>
    </div>

    <div>
      <label class="text-sm text-slate-300">Placa</label>
      <input name="placa" value="<%= vehiculo.placa %>" class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3" required>
    </div>

    <div>
      <label class="text-sm text-slate-300">Año</label>
      <input name="anio" value="<%= vehiculo.anio || '' %>" type="number" class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3">
    </div>

    <div>
      <label class="text-sm text-slate-300">VIN</label>
      <input name="vin" value="<%= vehiculo.vin || '' %>" class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3">
    </div>

    <div>
      <label class="text-sm text-slate-300">Color</label>
      <input name="color" value="<%= vehiculo.color || '' %>" class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3">
    </div>

    <div class="md:col-span-2 flex gap-2 mt-2">
      <button class="px-5 py-3 rounded-xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold">
        Guardar cambios
      </button>
      <a class="px-5 py-3 rounded-xl bg-white/10 border border-white/10" href="/taller/vehiculos">Volver</a>
    </div>
  </form>
</section>