<section class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-white/5 to-white/0 p-8 md:p-12">
  <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-cyan-500/20 blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"></div>

  <div class="grid md:grid-cols-2 gap-8 items-start">
    <div class="space-y-4">
      <p class="text-cyan-300 text-sm tracking-wide">SMART GARAGE</p>
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight">
        Registro con <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-500">protección de datos</span>
      </h1>
      <p class="text-slate-300 leading-relaxed">
        Para crear una cuenta es necesario aceptar el Aviso de Privacidad y la Política de Privacidad.
        Esta medida documenta el consentimiento informado del usuario antes de recopilar y procesar sus datos personales.
      </p>

      <div class="mt-6 grid grid-cols-1 gap-3 text-sm text-slate-300">
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <p class="font-semibold text-slate-100">Finalidad</p>
          <p class="mt-1">Administración de usuarios, vehículos, órdenes de mantenimiento y reportes.</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <p class="font-semibold text-slate-100">Derechos ARCO</p>
          <p class="mt-1">Acceso, rectificación, cancelación y oposición al tratamiento de datos personales.</p>
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-white/10 bg-white/5 p-6 md:p-8">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-2xl font-bold">Crear cuenta</h2>
        <span class="text-xs px-2 py-1 rounded-full bg-white/10 border border-white/10 text-slate-300">LFPDPPP</span>
      </div>
      <p class="mt-2 text-sm text-slate-300">Completa tus datos y confirma el consentimiento informado.</p>

      <% if (error) { %>
        <div class="mt-4 rounded-2xl border border-rose-500/30 bg-rose-500/10 p-4 text-rose-200 text-sm">
          <b>Error:</b> <%= error %>
        </div>
      <% } %>

      <form class="mt-6 space-y-4" method="POST" action="/auth/register" id="registerForm">
        <div>
          <label class="text-sm text-slate-300">Nombre completo</label>
          <input
            name="nombre"
            type="text"
            required
            minlength="3"
            value="<%= values.nombre %>"
            class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3 outline-none focus:border-cyan-400/40"
            placeholder="Nombre del usuario"
          />
        </div>

        <div>
          <label class="text-sm text-slate-300">Correo electrónico</label>
          <input
            name="email"
            type="email"
            required
            autocomplete="email"
            value="<%= values.email %>"
            class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3 outline-none focus:border-cyan-400/40"
            placeholder="usuario@correo.com"
          />
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="text-sm text-slate-300">Contraseña</label>
            <input
              name="password"
              type="password"
              required
              minlength="6"
              class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3 outline-none focus:border-cyan-400/40"
              placeholder="Mínimo 6 caracteres"
            />
          </div>
          <div>
            <label class="text-sm text-slate-300">Confirmar contraseña</label>
            <input
              name="confirmPassword"
              type="password"
              required
              minlength="6"
              class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3 outline-none focus:border-cyan-400/40"
              placeholder="Repite la contraseña"
            />
          </div>
        </div>

        <div class="rounded-2xl border border-cyan-400/20 bg-cyan-400/10 p-4 text-sm text-slate-200">
          <label class="flex items-start gap-3 cursor-pointer">
            <input
              type="checkbox"
              id="aceptaPrivacidad"
              name="aceptaPrivacidad"
              value="1"
              required
              class="mt-1 h-4 w-4 rounded border-white/20 bg-slate-950"
            />
            <span>
              Acepto el
              <a class="text-cyan-300 hover:underline" href="/legal/aviso-privacidad" target="_blank">Aviso de Privacidad</a>
              y la
              <a class="text-cyan-300 hover:underline" href="/legal/politica-privacidad" target="_blank">Política de Privacidad</a>.
            </span>
          </label>
          <p class="mt-2 text-xs text-slate-400">
            Esta aceptación es obligatoria para registrar la cuenta y tratar los datos personales del usuario.
          </p>
        </div>

        <button
          type="submit"
          class="w-full px-5 py-3 rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold"
        >
          Crear cuenta
        </button>

        <div class="flex items-center justify-between text-sm text-slate-400">
          <a class="hover:text-cyan-300" href="/auth/login">Ya tengo cuenta</a>
          <a class="hover:text-cyan-300" href="/">← Volver al sitio</a>
        </div>
      </form>
    </div>
  </div>
</section>
