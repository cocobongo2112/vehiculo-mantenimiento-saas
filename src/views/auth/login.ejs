<section class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-white/5 to-white/0 p-8 md:p-12">
  <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-cyan-500/20 blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"></div>

  <div class="grid md:grid-cols-2 gap-8 items-center">
    <!-- Left: Branding -->
    <div class="space-y-4">
      <p class="text-cyan-300 text-sm tracking-wide">SMART GARAGE</p>
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight">
        Acceso seguro a tu <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-500">panel</span>
      </h1>
      <p class="text-slate-300">
        Administra clientes, vehículos y órdenes. Genera reportes PDF y automatiza notificaciones con n8n + IA.
      </p>

      <div class="mt-6 grid grid-cols-2 gap-3 text-xs text-slate-300">
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <p class="text-slate-400">Seguridad</p>
          <p class="font-semibold">Sesión + Roles</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <p class="text-slate-400">Automatización</p>
          <p class="font-semibold">n8n + Telegram</p>
        </div>
      </div>

      <div class="mt-6 p-4 rounded-2xl bg-slate-900/60 border border-white/10 text-sm text-slate-300">
        Tip: si eres cliente final, usa el <a class="text-cyan-300 hover:underline" href="/chat">Chatbot</a> para consultar el estado de tu vehículo.
      </div>
    </div>

    <!-- Right: Form -->
    <div class="rounded-3xl border border-white/10 bg-white/5 p-6 md:p-8">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold">Iniciar sesión</h2>
        <span class="text-xs px-2 py-1 rounded-full bg-white/10 border border-white/10 text-slate-300">SaaS</span>
      </div>
      <p class="mt-2 text-sm text-slate-300">Ingresa tus credenciales para continuar.</p>

      <% if (error) { %>
        <div class="mt-4 rounded-2xl border border-rose-500/30 bg-rose-500/10 p-4 text-rose-200 text-sm">
          <b>Error:</b> <%= error %>
        </div>
      <% } %>

      <form class="mt-6 space-y-4" method="POST" action="/auth/login" id="loginForm">
        <div>
          <label class="text-sm text-slate-300">Email</label>
          <input
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-2 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3 outline-none focus:border-cyan-400/40"
            placeholder="admin@demo.com"
          />
        </div>

        <div>
          <label class="text-sm text-slate-300">Contraseña</label>
          <div class="mt-2 relative">
            <input
              name="password"
              type="password"
              required
              autocomplete="current-password"
              class="w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3 pr-12 outline-none focus:border-cyan-400/40"
              placeholder="••••••••"
              id="password"
            />
            <button type="button" id="togglePass"
              class="absolute right-2 top-1/2 -translate-y-1/2 px-3 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-xs">
              Ver
            </button>
          </div>
          <p class="mt-2 text-xs text-slate-500">Protegido con hash (bcrypt) en base de datos.</p>
        </div>

        <button
          type="submit"
          class="w-full px-5 py-3 rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold"
        >
          Entrar
        </button>

        <div class="flex items-center justify-between text-sm text-slate-400">
          <a class="hover:text-cyan-300" href="/">← Volver al sitio</a>
          <a class="hover:text-cyan-300" href="/auth/register">Crear cuenta</a>
        </div>

        <div class="mt-4 rounded-2xl border border-white/10 bg-slate-900/40 p-4 text-xs text-slate-300">
          <p class="font-semibold text-slate-200">Demo rápida</p>
          <p class="mt-1">Admin: <span class="text-cyan-300">admin@demo.com</span></p>
          <p>Pass: <span class="text-cyan-300">Admin123*</span></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("togglePass");
  const pass = document.getElementById("password");

  btn?.addEventListener("click", () => {
    const isHidden = pass.type === "password";
    pass.type = isHidden ? "text" : "password";
    btn.textContent = isHidden ? "Ocultar" : "Ver";
  });

  // mini UX
  const form = document.getElementById("loginForm");
  form?.addEventListener("submit", () => {
    // podrías poner loader, aquí simple:
    // alert("Iniciando sesión...");
  });
</script>
