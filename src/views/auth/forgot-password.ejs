<section class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-white/5 to-white/0 p-8 md:p-12">
  <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-cyan-500/20 blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"></div>

  <div class="grid md:grid-cols-2 gap-8 items-center">
    <!-- Lado izquierdo -->
    <div class="space-y-5">
      <p class="text-cyan-300 text-sm tracking-[0.25em] uppercase">Smart Garage</p>

      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight">
        Recupera el acceso a tu
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-500">
          cuenta
        </span>
      </h1>

      <p class="text-slate-300 leading-relaxed">
        Ingresa tu correo electrónico para generar un enlace de recuperación.
        En esta versión del proyecto, el proceso es funcional dentro del sistema y muestra
        el enlace de restablecimiento de forma simulada.
      </p>

      <div class="grid sm:grid-cols-2 gap-3 pt-2">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-xs uppercase tracking-wide text-slate-400">Método</p>
          <p class="mt-1 font-semibold text-slate-100">Token temporal</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-xs uppercase tracking-wide text-slate-400">Validez</p>
          <p class="mt-1 font-semibold text-slate-100">30 minutos</p>
        </div>
      </div>

      <div class="rounded-2xl border border-cyan-400/20 bg-cyan-400/5 p-4 text-sm text-slate-300">
        <span class="font-semibold text-cyan-300">Nota:</span>
        Si el correo existe en el sistema, se generará un enlace para restablecer la contraseña.
      </div>
    </div>

    <!-- Lado derecho -->
    <div class="rounded-3xl border border-white/10 bg-slate-900/60 backdrop-blur-sm p-6 md:p-8 shadow-2xl shadow-cyan-950/20">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-2xl font-bold text-slate-100">Recuperar contraseña</h2>
          <p class="mt-1 text-sm text-slate-400">Genera un enlace para restablecer tu acceso.</p>
        </div>

        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300">
          Seguridad
        </span>
      </div>

      <% if (error) { %>
        <div class="mt-5 rounded-2xl border border-rose-500/30 bg-rose-500/10 p-4 text-sm text-rose-200">
          <span class="font-semibold">Error:</span> <%= error %>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="mt-5 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-sm text-emerald-200">
          <span class="font-semibold">Correcto:</span> <%= success %>
        </div>
      <% } %>

      <form action="/auth/forgot-password" method="POST" class="mt-6 space-y-5">
        <div>
          <label for="email" class="block text-sm font-medium text-slate-300">
            Correo electrónico
          </label>
          <div class="mt-2">
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="ejemplo@correo.com"
              class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-slate-100 placeholder:text-slate-500 caret-cyan-400 outline-none transition-all focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20"
            >
          </div>
          <p class="mt-2 text-xs text-slate-500">
            Escribe el correo con el que registraste tu cuenta.
          </p>
        </div>

        <button
          type="submit"
          class="w-full rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 px-5 py-3 font-semibold text-slate-950 transition-transform hover:-translate-y-0.5"
        >
          Generar enlace de recuperación
        </button>
      </form>

      <% if (resetLink) { %>
        <div class="mt-6 rounded-2xl border border-cyan-400/20 bg-slate-950/60 p-4">
          <p class="text-sm font-semibold text-cyan-300">Enlace de recuperación generado</p>
          <p class="mt-2 text-sm text-slate-400">
            Haz clic en el enlace para continuar con el restablecimiento:
          </p>

          <div class="mt-3 rounded-xl border border-white/10 bg-white/5 p-3 break-all">
            <a
              href="<%= resetLink %>"
              class="text-sm text-cyan-300 hover:text-cyan-200 hover:underline"
            >
              <%= resetLink %>
            </a>
          </div>
        </div>
      <% } %>

      <div class="mt-6 flex items-center justify-between gap-3 text-sm text-slate-400">
        <a href="/auth/login" class="hover:text-cyan-300 transition-colors">← Volver al login</a>
        <a href="/contacto" class="hover:text-cyan-300 transition-colors">Soporte</a>
      </div>
    </div>
  </div>
</section>