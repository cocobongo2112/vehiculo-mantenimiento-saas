<section class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-white/5 to-white/0 p-8 md:p-12">
  <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-cyan-500/20 blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"></div>

  <p class="text-cyan-300 text-sm tracking-wide">SERVICIOS</p>
  <h1 class="mt-3 text-4xl md:text-5xl font-extrabold leading-tight">
    Todo lo que tu taller necesita en una sola plataforma
  </h1>
  <p class="mt-4 text-slate-300 max-w-3xl">
    Smart Garage centraliza operación, clientes, vehículos y órdenes de servicio. Además automatiza notificaciones con n8n + IA y entrega reportes PDF.
  </p>

  <!-- 🔥 CARRUSEL PRO -->
<div class="mt-10 animar-scroll">
  <div class="relative w-full max-w-4xl mx-auto overflow-hidden rounded-2xl">

    <!-- IMÁGENES -->
    <div id="carruselPro" class="flex transition-transform duration-700">
      <img src="/img/1.png" class="w-full flex-shrink-0">
      <img src="/img/2.png" class="w-full flex-shrink-0">
      <img src="/img/3.png" class="w-full flex-shrink-0">
      <img src="/img/4.png" class="w-full flex-shrink-0">
      <img src="/img/5.png" class="w-full flex-shrink-0">
      <img src="/img/6.png" class="w-full flex-shrink-0">
    </div>

    <!-- BOTONES -->
    <button onclick="prevSlide()" class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/40 px-3 py-2 rounded-full">◀</button>
    <button onclick="nextSlide()" class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/40 px-3 py-2 rounded-full">▶</button>

    <!-- INDICADORES -->
    <div class="absolute bottom-3 w-full flex justify-center gap-2">
      <span class="dot w-3 h-3 bg-white/50 rounded-full"></span>
      <span class="dot w-3 h-3 bg-white/50 rounded-full"></span>
      <span class="dot w-3 h-3 bg-white/50 rounded-full"></span>
      <span class="dot w-3 h-3 bg-white/50 rounded-full"></span>
      <span class="dot w-3 h-3 bg-white/50 rounded-full"></span>
      <span class="dot w-3 h-3 bg-white/50 rounded-full"></span>
    </div>

  </div>
</div>

<div class="mt-10 grid md:grid-cols-3 gap-6">
  <% const cards = [
    { t:"CRM de Clientes", d:"Registro, historial, contacto y seguimiento.", i:"👤" },
    { t:"Vehículos e Historial", d:"Placas, modelo, marca, bitácora y servicios.", i:"🚘" },
    { t:"Órdenes de Servicio", d:"Estados, fechas de entrega y control del flujo.", i:"🧾" },
    { t:"Dashboard", d:"Métricas y estado general en tiempo real.", i:"📊" },
    { t:"Chatbot Web", d:"Consulta de estado por folio desde el sitio.", i:"💬" },
    { t:"Automatización + IA", d:"Notificaciones y recomendaciones inteligentes.", i:"🤖" }
  ]; %>

  <% cards.forEach(c => { %>
    <div class="animar-scroll">
      <div class="flip-card"
           onmouseenter="flipCard(this)"
           onmouseleave="unflipCard(this)">

        <div class="flip-panel flip-front rounded-2xl border border-white/10 bg-white/5 p-6">
          <div class="text-5xl text-center"><%= c.i %></div>
          <h3 class="mt-4 text-xl font-semibold text-center"><%= c.t %></h3>
          <p class="mt-2 text-slate-400 text-sm text-center">Pasa el mouse</p>
        </div>

        <div class="flip-panel flip-back rounded-2xl border border-white/10 bg-gradient-to-br from-cyan-400/20 to-indigo-500/20 p-6">
          <h3 class="text-xl font-semibold text-center"><%= c.t %></h3>
          <p class="mt-3 text-slate-200 text-center"><%= c.d %></p>
          <div class="mt-4 text-sm text-slate-300 text-center">
            Optimiza procesos, mejora el control y automatiza tu taller 🚀
          </div>
        </div>

      </div>
    </div>
  <% }) %>
</div>

  <div class="mt-12 grid md:grid-cols-2 gap-6">
    <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-6">
      <h3 class="text-xl font-semibold">Planes de servicio</h3>
      <p class="mt-2 text-slate-300">
        Propuesta de planes para adaptar la plataforma según el tamaño y operación del taller.
      </p>

      <div class="mt-5 grid sm:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <p class="text-sm text-slate-400">Starter</p>
          <p class="text-3xl font-extrabold">$0</p>
          <p class="text-slate-300 mt-1 text-sm">Ideal para talleres en adopción inicial</p>
          <ul class="mt-4 text-sm text-slate-300 space-y-2 list-disc list-inside">
            <li>CRM básico</li>
            <li>Órdenes de servicio</li>
            <li>Chatbot</li>
          </ul>
        </div>

        <div class="rounded-2xl border border-cyan-400/30 bg-gradient-to-br from-cyan-400/15 to-indigo-500/10 p-5">
          <p class="text-sm text-cyan-300">Pro</p>
          <p class="text-3xl font-extrabold">$299</p>
          <p class="text-slate-300 mt-1 text-sm">Presentación SaaS premium</p>
          <ul class="mt-4 text-sm text-slate-200 space-y-2 list-disc list-inside">
            <li>Dashboards avanzados</li>
            <li>Reportes PDF</li>
            <li>Automatización n8n + IA</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
      <h3 class="text-xl font-semibold">¿Listo para una demo?</h3>
      <p class="mt-2 text-slate-300">
        Muestra al profesor un producto con sitio público + panel privado + automatización real.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/contacto" class="px-5 py-3 rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold">
          Contactar
        </a>
        <a href="/auth/login" class="px-5 py-3 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/10">
          Iniciar sesión
        </a>
      </div>

      <div class="mt-8 p-4 rounded-2xl bg-slate-900/60 border border-white/10 text-sm text-slate-300">
        ✅ Incluye: CRM, Vehículos, Órdenes, Reportes, Chatbot, n8n + Telegram.
      </div>
    </div>
  </div>
</section>
  