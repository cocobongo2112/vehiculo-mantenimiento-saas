<section class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/5 to-white/0 p-8 md:p-12 overflow-hidden relative">
  <div class="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-cyan-500/10 blur-3xl"></div>
  <div class="absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-indigo-500/10 blur-3xl"></div>

  <div class="animar-scroll">
    <p class="text-cyan-300 text-sm tracking-wide">CONTACTO</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-extrabold">Hablemos de tu taller</h1>
    <p class="mt-4 text-slate-300 max-w-3xl">
      Solicita una demo de Smart Garage o pregúntanos sobre implementación. Respuesta rápida.
    </p>
  </div>

  <!-- BLOQUE DESTACADO -->
  <div class="mt-8 animar-scroll">
    <div class="contact-highlight rounded-2xl border border-cyan-400/20 bg-gradient-to-r from-cyan-400/10 to-indigo-500/10 p-5 md:p-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <p class="text-cyan-300 text-sm font-semibold tracking-wide">ATENCIÓN PREMIUM</p>
          <h3 class="text-2xl font-bold mt-1">Soporte, seguimiento y demo personalizada</h3>
          <p class="mt-2 text-slate-300">
            Descubre cómo Smart Garage mejora la organización, automatiza tareas y eleva la atención a tus clientes.
          </p>
        </div>

        <button
          type="button"
          onclick="toggleInfo()"
          class="contact-toggle-btn px-5 py-3 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/10 font-semibold">
          Ver beneficios
        </button>
      </div>

      <div id="info" class="contact-extra hidden-content mt-5">
        <div class="grid md:grid-cols-3 gap-4">
          <div class="contact-mini-card rounded-2xl border border-white/10 bg-slate-950/40 p-4">
            <div class="text-2xl">⏰</div>
            <h4 class="mt-2 font-semibold">Horario extendido</h4>
            <p class="mt-1 text-sm text-slate-300">Disponibilidad amplia para resolver dudas y coordinar demos.</p>
          </div>

          <div class="contact-mini-card rounded-2xl border border-white/10 bg-slate-950/40 p-4">
            <div class="text-2xl">⭐</div>
            <h4 class="mt-2 font-semibold">Soporte prioritario</h4>
            <p class="mt-1 text-sm text-slate-300">Atención enfocada en implementación, seguimiento y uso del sistema.</p>
          </div>

          <div class="contact-mini-card rounded-2xl border border-white/10 bg-slate-950/40 p-4">
            <div class="text-2xl">🤝</div>
            <h4 class="mt-2 font-semibold">Atención personalizada</h4>
            <p class="mt-1 text-sm text-slate-300">Te guiamos según el tamaño y necesidades reales de tu taller.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-10 grid md:grid-cols-2 gap-6">
    <!-- FORMULARIO -->
    <div class="animar-scroll rounded-2xl border border-white/10 bg-white/5 p-6 hover-lift">
      <h3 class="text-xl font-semibold">Enviar solicitud</h3>
      <p class="mt-2 text-slate-300 text-sm">
        Déjanos tus datos y te mostramos cómo funciona Smart Garage en una demo.
      </p>

      <form class="mt-5 space-y-4">
        <div class="form-field">
          <label class="text-sm text-slate-300">Nombre</label>
          <input
            class="mt-1 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3 outline-none focus:border-cyan-400/40 focus:ring-2 focus:ring-cyan-400/10 transition"
            placeholder="Tu nombre" />
        </div>

        <div class="form-field">
          <label class="text-sm text-slate-300">Email</label>
          <input
            type="email"
            class="mt-1 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3 outline-none focus:border-cyan-400/40 focus:ring-2 focus:ring-cyan-400/10 transition"
            placeholder="correo@ejemplo.com" />
        </div>

        <div class="form-field">
          <label class="text-sm text-slate-300">Mensaje</label>
          <textarea
            rows="4"
            class="mt-1 w-full rounded-xl bg-slate-950/60 border border-white/10 px-4 py-3 outline-none focus:border-cyan-400/40 focus:ring-2 focus:ring-cyan-400/10 transition"
            placeholder="Cuéntanos qué necesitas"></textarea>
        </div>

        <button
          type="button"
          class="w-full px-5 py-3 rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold transition hover:scale-[1.02] hover:shadow-xl">
          Enviar solicitud
        </button>

        <p class="text-xs text-slate-500">
          * En demo académica, el formulario puede ser solo UI o conectarse después a BD / n8n.
        </p>
      </form>
    </div>

    <!-- INFORMACIÓN -->
    <div class="animar-scroll rounded-2xl border border-white/10 bg-white/5 p-6 hover-lift">
      <h3 class="text-xl font-semibold">Información</h3>

      <div class="mt-4 space-y-3 text-slate-300">
        <div class="info-card p-4 rounded-2xl bg-slate-900/60 border border-white/10">
          <p class="text-sm text-slate-400">Correo</p>
          <p class="font-semibold">contacto@smartgarage.app</p>
        </div>

        <div class="info-card p-4 rounded-2xl bg-slate-900/60 border border-white/10">
          <p class="text-sm text-slate-400">Horario</p>
          <p class="font-semibold">Lun–Sáb · 9:00 a 18:00</p>
        </div>

        <div class="info-card p-4 rounded-2xl bg-slate-900/60 border border-white/10">
          <p class="text-sm text-slate-400">Soporte</p>
          <p class="font-semibold">Chatbot web + Notificaciones Telegram</p>
        </div>
      </div>

      <div class="mt-6">
        <a
          class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/30 transition hover:scale-105"
          href="https://wa.me/5210000000000"
          target="_blank">
          <span>💚</span> WhatsApp (demo)
        </a>
        <p class="mt-2 text-xs text-slate-500">Cambia el número cuando quieras.</p>
      </div>

      <div class="mt-10">
        <h4 class="text-lg font-semibold">Preguntas frecuentes</h4>

        <div class="mt-4 space-y-3">
          <details class="faq-card rounded-2xl border border-white/10 bg-slate-900/40 p-4">
            <summary class="cursor-pointer font-semibold">¿Smart Garage funciona como SaaS?</summary>
            <p class="mt-2 text-slate-300 text-sm">
              Sí, es accesible desde web y se puede escalar por empresa o taller.
            </p>
          </details>

          <details class="faq-card rounded-2xl border border-white/10 bg-slate-900/40 p-4">
            <summary class="cursor-pointer font-semibold">¿Incluye IA y automatización?</summary>
            <p class="mt-2 text-slate-300 text-sm">
              Integra n8n + IA para notificaciones, alertas y generación de reportes.
            </p>
          </details>

          <details class="faq-card rounded-2xl border border-white/10 bg-slate-900/40 p-4">
            <summary class="cursor-pointer font-semibold">¿Hay chatbot para clientes?</summary>
            <p class="mt-2 text-slate-300 text-sm">
              Sí, permite consultar el estado del vehículo por folio y recibir información rápida.
            </p>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>