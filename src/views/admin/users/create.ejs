<section class="max-w-3xl mx-auto rounded-3xl border border-white/10 bg-gradient-to-br from-white/5 to-white/0 p-8 md:p-12">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-cyan-300 text-sm tracking-wide">ADMIN · NUEVO USUARIO</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-extrabold">Crear usuario</h1>
      <p class="mt-2 text-slate-300">Registra una nueva cuenta para administración o personal de taller.</p>
    </div>
    <a href="/admin/users" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">Volver</a>
  </div>

  <% if (error) { %>
    <div class="mt-6 rounded-2xl border border-rose-500/30 bg-rose-500/10 p-4 text-sm text-rose-200"><%= error %></div>
  <% } %>

  <form method="POST" action="/admin/users/new" class="mt-8 grid md:grid-cols-2 gap-5">
    <div class="md:col-span-2">
      <label class="block text-sm font-medium text-slate-300">Nombre completo</label>
      <input name="nombre" value="<%= values.nombre %>" required class="mt-2 w-full rounded-2xl bg-slate-950/70 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-500 outline-none focus:border-cyan-400/40 focus:ring-2 focus:ring-cyan-400/20" placeholder="Nombre del usuario" />
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-300">Correo electrónico</label>
      <input type="email" name="email" value="<%= values.email %>" required class="mt-2 w-full rounded-2xl bg-slate-950/70 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-500 outline-none focus:border-cyan-400/40 focus:ring-2 focus:ring-cyan-400/20" placeholder="usuario@empresa.com" />
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-300">Contraseña inicial</label>
      <input type="password" name="password" required class="mt-2 w-full rounded-2xl bg-slate-950/70 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-500 outline-none focus:border-cyan-400/40 focus:ring-2 focus:ring-cyan-400/20" placeholder="Mínimo 6 caracteres" />
    </div>

    <div class="md:col-span-2">
      <label class="block text-sm font-medium text-slate-300">Rol</label>
      <select name="role_id" required class="mt-2 w-full rounded-2xl bg-slate-950/70 border border-white/10 px-4 py-3 text-slate-100 outline-none focus:border-cyan-400/40 focus:ring-2 focus:ring-cyan-400/20">
        <option value="">-- Selecciona un rol --</option>
        <% roles.forEach(r => { %>
          <option value="<%= r.id %>" <%= String(values.role_id) === String(r.id) ? 'selected' : '' %>><%= r.nombre %></option>
        <% }) %>
      </select>
    </div>

    <div class="md:col-span-2 flex justify-end gap-3 pt-2">
      <a href="/admin/users" class="px-5 py-3 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">Cancelar</a>
      <button type="submit" class="px-5 py-3 rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold text-sm">Crear usuario</button>
    </div>
  </form>
</section>
