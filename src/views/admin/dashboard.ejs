<section class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/5 to-white/0 p-8 md:p-12">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <p class="text-cyan-300 text-sm tracking-wide">ADMIN · SMART GARAGE</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-extrabold">Dashboard Administrativo</h1>
      <p class="mt-2 text-slate-300">Visión general del sistema, productividad operativa y accesos principales.</p>
    </div>

    <div class="flex flex-wrap gap-2">
      <a href="/admin/users" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">Usuarios</a>
      <a href="/admin/reportes" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-sm">Reportes</a>
      <a href="/taller/ordenes" class="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-semibold text-sm">Ver órdenes</a>
    </div>
  </div>

  <div class="mt-8 grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><p class="text-sm text-slate-400">Usuarios</p><p class="mt-2 text-3xl font-extrabold"><%= kpis.usuarios %></p><p class="mt-1 text-xs text-slate-500">Cuentas registradas</p></div>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><p class="text-sm text-slate-400">Clientes</p><p class="mt-2 text-3xl font-extrabold"><%= kpis.clientes %></p><p class="mt-1 text-xs text-slate-500">CRM activo</p></div>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><p class="text-sm text-slate-400">Órdenes</p><p class="mt-2 text-3xl font-extrabold"><%= kpis.ordenes %></p><p class="mt-1 text-xs text-slate-500">Histórico total</p></div>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><p class="text-sm text-slate-400">Cumplimiento</p><p class="mt-2 text-3xl font-extrabold"><%= kpis.cumplimiento %>%</p><p class="mt-1 text-xs text-slate-500">Órdenes entregadas</p></div>
  </div>

  <div class="mt-8 grid lg:grid-cols-3 gap-6">
    <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
      <h3 class="text-lg font-semibold">Rendimiento operativo</h3>
      <div class="mt-5 space-y-4 text-sm">
        <div>
          <div class="flex justify-between text-slate-300"><span>Órdenes pendientes</span><span><%= kpis.pendientes %></span></div>
          <div class="mt-2 h-2 rounded-full bg-slate-800 overflow-hidden"><div class="h-full rounded-full bg-cyan-400" style="width:<%= Math.min(100, (kpis.pendientes / Math.max(kpis.ordenes,1))*100) %>%"></div></div>
        </div>
        <div>
          <div class="flex justify-between text-slate-300"><span>Órdenes entregadas</span><span><%= kpis.entregadas %></span></div>
          <div class="mt-2 h-2 rounded-full bg-slate-800 overflow-hidden"><div class="h-full rounded-full bg-emerald-400" style="width:<%= Math.min(100, (kpis.entregadas / Math.max(kpis.ordenes,1))*100) %>%"></div></div>
        </div>
        <div>
          <div class="flex justify-between text-slate-300"><span>Órdenes creadas este mes</span><span><%= kpis.ordenesMes %></span></div>
          <div class="mt-2 h-2 rounded-full bg-slate-800 overflow-hidden"><div class="h-full rounded-full bg-indigo-400" style="width:<%= Math.min(100, (kpis.ordenesMes / Math.max(kpis.ordenes,1))*100) %>%"></div></div>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
      <h3 class="text-lg font-semibold">Órdenes por estado</h3>
      <div class="mt-4 space-y-3">
        <% if (ordenesPorEstado && ordenesPorEstado.length) { %>
          <% ordenesPorEstado.forEach(s => { const total = Math.max(kpis.ordenes,1); %>
            <div>
              <div class="flex items-center justify-between text-sm text-slate-300 mb-2"><span><%= s.estado %></span><span><%= s.cantidad %></span></div>
              <div class="h-2 rounded-full bg-slate-800 overflow-hidden"><div class="h-full rounded-full bg-gradient-to-r from-cyan-400 to-indigo-500" style="width:<%= Math.min(100, (s.cantidad / total) * 100) %>%"></div></div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 text-slate-400">Sin datos aún.</div>
        <% } %>
      </div>
    </div>

    <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
      <h3 class="text-lg font-semibold">Accesos principales</h3>
      <div class="mt-4 grid gap-3">
        <a href="/admin/users" class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 hover:bg-slate-900 transition"><div class="text-sm text-slate-400">Gestión</div><div class="mt-1 font-semibold">Usuarios y roles</div></a>
        <a href="/admin/reportes" class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 hover:bg-slate-900 transition"><div class="text-sm text-slate-400">Análisis</div><div class="mt-1 font-semibold">Reportes y exportación</div></a>
        <a href="/taller/ordenes" class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 hover:bg-slate-900 transition"><div class="text-sm text-slate-400">Operación</div><div class="mt-1 font-semibold">Órdenes de servicio</div></a>
      </div>
    </div>
  </div>

  <div class="mt-8 grid lg:grid-cols-5 gap-6">
    <div class="lg:col-span-2 rounded-2xl border border-white/10 bg-white/5 p-6">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold">Últimos usuarios</h3>
        <span class="text-xs text-slate-400">Top 5</span>
      </div>
      <div class="mt-4 space-y-3">
        <% if (ultimosUsuarios && ultimosUsuarios.length) { %>
          <% ultimosUsuarios.forEach(u => { %>
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 flex items-center justify-between gap-3">
              <div>
                <div class="font-semibold"><%= u.nombre %></div>
                <div class="text-sm text-slate-400"><%= u.email %></div>
              </div>
              <span class="px-2 py-1 rounded-full text-xs <%= u.activo === 1 ? 'bg-emerald-500/15 text-emerald-200 border border-emerald-500/30' : 'bg-rose-500/15 text-rose-200 border border-rose-500/30' %>"><%= u.activo === 1 ? 'Activo' : 'Inactivo' %></span>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-slate-400">Sin usuarios para mostrar.</div>
        <% } %>
      </div>
    </div>

    <div class="lg:col-span-3 rounded-2xl border border-white/10 bg-white/5 p-6 overflow-x-auto">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold">Órdenes recientes</h3>
        <span class="text-xs text-slate-400">Últimas 8</span>
      </div>
      <table class="min-w-full text-sm mt-4">
        <thead class="text-slate-400">
          <tr class="border-b border-white/10">
            <th class="text-left py-3 pr-4">Folio</th>
            <th class="text-left py-3 pr-4">Cliente</th>
            <th class="text-left py-3 pr-4">Vehículo</th>
            <th class="text-left py-3 pr-4">Prioridad</th>
            <th class="text-left py-3">Estado</th>
          </tr>
        </thead>
        <tbody class="text-slate-200">
          <% if (ultimasOrdenes && ultimasOrdenes.length) { %>
            <% ultimasOrdenes.forEach(o => { %>
              <tr class="border-b border-white/5 hover:bg-white/5">
                <td class="py-3 pr-4 font-semibold"><%= o.folio %></td>
                <td class="py-3 pr-4"><%= o.cliente %></td>
                <td class="py-3 pr-4 text-slate-300"><%= o.marca %> <%= o.modelo %> (<%= o.placa %>)</td>
                <td class="py-3 pr-4"><span class="px-2 py-1 rounded-full text-xs bg-white/10 border border-white/10"><%= o.prioridad %></span></td>
                <td class="py-3"><span class="px-2 py-1 rounded-full text-xs bg-cyan-500/15 border border-cyan-500/30 text-cyan-200"><%= o.estado %></span></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="py-8 text-slate-400">Sin órdenes para mostrar.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>
