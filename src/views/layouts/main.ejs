<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || "Smart Garage" %></title>

  <meta name="description" content="Smart Garage - Plataforma SaaS para gestión de mantenimiento vehicular con CRM, dashboards, chatbot, IA y automatización con n8n." />

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    .bg-grid{
      background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,.08) 1px, transparent 0);
      background-size: 28px 28px;
    }
  </style>
</head>

<body class="min-h-screen bg-slate-950 text-slate-100">
  <a href="#contenido-principal" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:m-3 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-slate-950">Saltar al contenido principal</a>
  <div class="bg-grid min-h-screen">
    <%- include("../partials/navbar") %>

    <main id="contenido-principal" class="max-w-6xl mx-auto px-4 py-10">
      <%- body %>
    </main>

    <%- include("../partials/footer") %>
  </div>
<script src="/js/app.js"></script>
</body>
</html>
